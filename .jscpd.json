{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "path": [
    "apps/api/app",
    "apps/api/routes",
    "apps/api/database/factories",
    "apps/api/database/seeders",
    "apps/web/src",
    "apps/web/e2e"
  ],
  "format": ["php", "typescript", "tsx"],
  "minTokens": 50,
  "threshold": 3,
  "reporters": ["console"],
  "ignore": ["**/*.test.ts", "**/*.test.tsx", "**/locales/**"],
  "absolute": false,
  "gitignore": true
}
