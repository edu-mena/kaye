{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://kayeangola.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://kayeangola.com/:path*",
      "statusCode": 301
    }
  ]
}
