# Kayé API. Every variable is explained in docs/infraestrutura.md.
# Values here are for local development; production values are in that doc.

APP_NAME="Kayé"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Production: LOG_STACK=json and LOG_LEVEL=info (docs/observabilidade.md).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaye
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting has no Redis: sessions, cache and queue live in the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies only over HTTPS).
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Emails (docs/infraestrutura.md): `log` here; production uses the Hostinger SMTP (smtp, port 465, scheme smtps).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ola@kaye.ao"
MAIL_FROM_NAME="${APP_NAME}"
# Messages sent per hour (campaigns and reminders), within the SMTP's own limit.
MAIL_HOURLY_LIMIT=80
PUSH_HOURLY_LIMIT=1000

# Web Push (VAPID). Generate once with `php artisan webpush:vapid --show`; empty = push off.
VAPID_SUBJECT=mailto:ola@kaye.ao
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Emails that may open /admin (comma-separated). Empty means nobody.
ADMIN_EMAILS=

# Origins of the native apps allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# API token lifetime for the Android app, in minutes (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# Login with Google (docs/arquitetura.md, 5.1): the web OAuth client from Google Cloud.
# Its redirect URI is APP_URL/auth/google/callback. Empty = nobody signs in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password for GET /api/v1/waitlist/export (CSV). 16 characters or more; empty = locked.
WAITLIST_EXPORT_TOKEN=

# Password for POST /api/v1/ingest/jobs (the scrapers' job facts). 16 characters or more; empty = locked.
INGEST_TOKEN=

# Optional (paid) Claude API key to write the summary of each collected piece of news (docs/fontes-de-noticias.md).
# Empty = a short excerpt cut by rules, no cost.
ANTHROPIC_API_KEY=
NEWS_AI_MODEL=claude-haiku-5-5

# The Upstash Redis of the old Vercel functions, only for `php artisan kaye:migrate-redis`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking (docs/observabilidade.md). Empty = off; required in production.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Detailed GET /api/v1/health (queue, cron, disk) for the uptime monitor. 16 characters or more; empty = only "ok".
HEALTH_TOKEN=
# The queue counts as stuck (alert email to ADMIN_EMAILS) when a job waits longer than this; the disk as full below this.
QUEUE_STUCK_MINUTES=15
DISK_MIN_FREE_PERCENT=10

# Pulse (slow requests and queries, in the panel at /admin/pulse). Stored in this database.
PULSE_ENABLED=true

# Daily backups (docs/infraestrutura.md, "Cópias de segurança"). BACKUP_DISK=backups sends them off the server to an
# S3-compatible bucket (AWS, Cloudflare R2, Backblaze B2); `local` keeps them here (development only).
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
# Where mysqldump is when it is not on the PATH (Windows: C:/xampp/mysql/bin).
DB_DUMP_BINARY_PATH=
# An empty database of its own for `kaye:backup-restore-test` (created in the hPanel). Empty = the weekly test is off.
DB_RESTORE_DATABASE=
DB_RESTORE_USERNAME=
DB_RESTORE_PASSWORD=

# "Pesquisar com IA" in the panel (docs/ia.md): the same ANTHROPIC_API_KEY. The latest Sonnet; Opus only on request.
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=medium
AI_DAILY_BUDGET_USD=2
AI_TASK_MAX_TOKENS=300000
# MCP tokens made in the panel (Ligação à IA) expire after this many days.
MCP_TOKEN_DAYS=90
