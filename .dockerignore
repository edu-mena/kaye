# Keep the build context small and free of secrets.
.git
.github
**/node_modules
**/.env
**/.env.*
!apps/api/.env.example
# Public build settings of the web app (VITE_DATA_SOURCE=api): no secrets.
!apps/web/.env.production
docs
scrapers

apps/api/vendor
apps/api/storage/logs/*
apps/api/storage/framework/cache/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/storage/framework/testing
apps/api/public/spa
apps/api/public/build
apps/api/public/css/filament
apps/api/public/js/filament
apps/api/public/fonts/filament
apps/api/bootstrap/cache/*.php

apps/web/android
apps/web/dist
apps/web/coverage
apps/web/playwright-report
apps/web/test-results
